# cp .env.example .env && chmod 600 .env
# 비밀값은 여기에만. config.toml 이나 git 에 넣지 말 것.

# 웹훅 인증 토큰(16자 이상). 생성: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=

# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# [카카오 로그인 > 보안 > Client Secret] 을 켰다면 필수
KAKAO_CLIENT_SECRET=

# (선택) 텔레그램 폴백
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (선택) IMAP 감시: 앱 비밀번호 권장
IMAP_PASSWORD=

# (선택·실험적) 키즈노트 웹 폴링: 브라우저 개발자도구에서 복사한 Cookie 헤더 값
KIDSNOTE_SESSION_COOKIE=
